# Copy this file to .env and fill in your key. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Optional overrides. Defaults live in src/config.py.
# MAX_LLM_CALLS=12
# MAX_SEARCHES=6
# MAX_FETCHES=6
# MAX_EMBED_CALLS=40
# MAX_STEPS=40
# MAX_RETRIES=3
# RETRY_BASE_SECONDS=0.5
# VALIDATION_REPAIRS=1
# CRITIC_MAX_ITERATIONS=2
# CHUNK_SIZE=800
# CHUNK_OVERLAP=120
# TOP_K=4
# FETCH_MAX_CHARS=6000
# FETCH_TIMEOUT_SECONDS=15
# SEARCH_RESULTS_PER_QUERY=2
# MAX_SUBQUESTIONS=3
# CACHE_DIR=data/cache
# CHROMA_DIR=data/chroma
# GEMINI_TEMPERATURE=0.2
